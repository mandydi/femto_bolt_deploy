# 5路 USB 高清相机硬件拓扑永久固定软链接规则
# 基于 Linux USB 物理拓扑端口 (by-path) 绝对死锁绑定

# 1号相机: 底部/低位相机 (USB 1-3)
SUBSYSTEM=="video4linux", KERNELS=="1-3:1.0", ATTR{index}=="0", SYMLINK+="camera_1"

# 2号相机: 侧面俯视滑槽相机 (USB 1-4)
SUBSYSTEM=="video4linux", KERNELS=="1-4:1.0", ATTR{index}=="0", SYMLINK+="camera_2"

# 3号相机: 正视传送带纸箱相机 (USB 1-6)
SUBSYSTEM=="video4linux", KERNELS=="1-6:1.0", ATTR{index}=="0", SYMLINK+="camera_3"

# 4号相机: 侧视传送带相机 (USB 1-7)
SUBSYSTEM=="video4linux", KERNELS=="1-7:1.0", ATTR{index}=="0", SYMLINK+="camera_4"

# 5号相机: 传送带/滑槽近景相机 (USB 1-8)
SUBSYSTEM=="video4linux", KERNELS=="1-8:1.0", ATTR{index}=="0", SYMLINK+="camera_5"
